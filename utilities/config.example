# Vaultwarden GCP Deploy - Config File Example
# Copy this to config.conf, fill in values, and run:
#   bash utilities/create-gcp-secrets.sh --config-file=config.conf
#
# Lines starting with # are comments. Format: key=value (no quotes needed)

# Required
project_id=your-gcp-project-id
hostname=vault.yourdomain.com
dns_provider=cloudflare
zone=yourdomain.com
acme_email=you@example.com
timezone=America/Los_Angeles

# Cloudflare (required if dns_provider=cloudflare)
cloudflare_token=cfat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DuckDNS (required if dns_provider=duckdns)
# duckdns_subdomain=your-subdomain
# duckdns_token=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Signup domains (comma-separated)
signup_domains_whitelist=yourdomain.com

# Backup
backup_bucket_name=your-project-vaultwarden-backups
backup_path=vaultwarden

# SMTP (Gmail example)
smtp_host=smtp.gmail.com
smtp_port=587
smtp_security=starttls
smtp_from=your@gmail.com
smtp_password=your-16-char-app-password

# Optional: SSO (Google Workspace OIDC)
# sso_enabled=true
# sso_authority=https://accounts.google.com
# sso_client_id=your-client-id.apps.googleusercontent.com
# sso_client_secret=your-client-secret
# sso_identifier=sso
# sso_only=false

# Optional: Custom secret names
# env_secret_name=vwgc-env
# ddclient_secret_name=vwgc-ddclient

# Optional: Terraform state bucket
# tfstate_bucket_name=your-project-vaultwarden-tfstate
# tfstate_bucket_location=us-central1
# tfstate_prefix=vaultwarden