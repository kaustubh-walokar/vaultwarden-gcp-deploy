# Example config file for create-gcp-secrets.sh
# Usage: bash utilities/create-gcp-secrets.sh --config-file=utilities/create-gcp-secrets.conf
# Or:    CONFIG_FILE=utilities/create-gcp-secrets.conf bash utilities/create-gcp-secrets.sh
#
# Lines starting with # are comments. Format: key=value
# All values from config file are used as defaults (you can still override interactively)

# GCP project ID (if not set, uses active gcloud project)
project_id=your-gcp-project-id

# Vaultwarden hostname (subdomain.domain.com)
hostname=vault.yourdomain.com

# DNS provider: cloudflare or duckdns
dns_provider=cloudflare

# Cloudflare zone (root domain, e.g., yourdomain.com)
zone=yourdomain.com

# DuckDNS subdomain (only if dns_provider=duckdns)
# duckdns_subdomain=your-subdomain

# Let's Encrypt email for SSL certificates
acme_email=you@yourdomain.com

# Timezone (TZ database name)
timezone=America/Los_Angeles

# Allowed signup email domains (comma or space separated)
signup_domains_whitelist=yourdomain.com

# Cloudflare API token (starts with cfat_, 53 chars)
cloudflare_token=cfat_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# DuckDNS token (UUID, only if dns_provider=duckdns)
# duckdns_token=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Backup bucket name (default: project_id-vaultwarden-backups)
backup_bucket_name=your-project-vaultwarden-backups

# Backup path inside bucket
backup_path=vaultwarden

# SMTP settings (for Vaultwarden emails and backup notifications)
smtp_host=smtp.gmail.com
smtp_port=587
smtp_security=starttls
smtp_from=your@gmail.com
smtp_password=your-16-char-app-password

# SSO / Bearer

# Enable SSO (true/false)
sso_enabled=false

# Require SSO only (true/false, only if sso_enabled=true)
sso_only=false

# SSO OpenID Connect issuer URL
sso_authority=https://accounts.google.com

# SSO client ID
sso_client_id=your-client-id.apps.googleusercontent.com

# SSO client secret
sso_client_secret=your-client-secret

# SSO identifier (cosmetic)
sso_identifier=sso

# Optional: override secret names
# env_secret_name=vwgc-env
# ddclient_secret_name=vwgc-ddclient

# Optional: Terraform state bucket settings
# tfstate_bucket_name=your-project-vaultwarden-tfstate
# tfstate_bucket_location=us-central1
# tfstate_prefix=vaultwarden