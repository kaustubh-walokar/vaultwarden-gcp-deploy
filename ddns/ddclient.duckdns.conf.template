# ddclient.conf (DuckDNS).
# Generated by utilities/create-gcp-secrets.sh from this template, with values
# filled from your setup answers and stored in Secret Manager. For a manual
# install, copy this file to ddns/ddclient.conf and fill in the values marked
# with double underscores yourself.
# Note: usev4/usev6 avoids older ddclient "use" update issues for some providers.

# ddclient updates __DUCKDNS_SUBDOMAIN__.duckdns.org. At your domain host, add a
# CNAME so __HOSTNAME__ points to __DUCKDNS_SUBDOMAIN__.duckdns.org. The host line
# below is the bare DuckDNS label only (no .duckdns.org suffix).

# IPv4 (recommended)
usev4=webv4, webv4=ipify-ipv4

# Optional IPv6
#usev6=webv6, webv6=ipify-ipv6

# --- Optional: use GCP metadata for public IP discovery instead of web ---
#usev4=cmd
#cmd='curl -sS -H "Metadata-Flavor: Google" http://169.254.169.254/computeMetadata/v1/instance/network-interfaces/0/access-configs/0/external-ip'

protocol=duckdns
server=www.duckdns.org
password=__DUCKDNS_TOKEN__
__DUCKDNS_SUBDOMAIN__
